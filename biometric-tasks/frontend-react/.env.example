# =========================================================
# Biometric2 — Frontend (Vite + React)
# Copy to .env and fill in. Never commit .env.
#
# NOTE: everything prefixed VITE_ is baked into the JS bundle
# and is PUBLIC. Never put secrets or private API keys here.
# =========================================================

# Backend API origin, no trailing slash.
# Local dev:  http://localhost:8000
# Docker:     http://localhost:9000
# Production: https://api.attendance.gridsphere.in
VITE_API_BASE_URL=https://api.attendance.gridsphere.in
