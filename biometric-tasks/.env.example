# =========================================================
# Biometric2 — Backend (FastAPI)
# Copy to .env and fill in real values. Never commit .env.
# Read by app/core/config.py (pydantic-settings, env_file=".env")
# =========================================================

PROJECT_NAME=GridSphere IoT Core

# --- Database (required) ---
# Async driver required. Examples:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
#   sqlite+aiosqlite:///./biometric.db
DATABASE_URL=

# --- Redis (optional in this repo — leave blank to disable) ---
# redis://HOST:6379/0
REDIS_URL=

# --- MQTT broker (MQTT_BROKER required) ---
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- JWT signing (REQUIRED) ---
# Anyone holding this can forge a token for any user, including super_admin.
# Leave blank and the server mints a random key per process instead — safe, but
# every restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Task manager / GitHub integration ---
# Encrypts per-tenant GitHub tokens at rest. Required to connect any repo.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_ENC_KEY=
# Minutes between reconcile passes that catch missed webhooks (0 disables)
GITHUB_SYNC_INTERVAL_MINUTES=30
# Pages of issues pulled per repo per pass, to stay inside rate limits
GITHUB_SYNC_PAGE_LIMIT=3
