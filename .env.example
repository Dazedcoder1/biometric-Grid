# =============================================================================
# Copy this file to .env at the repository root and fill it in:
#
#     copy .env.example .env
#
# ONE .env serves the whole project.
#   Backend   app/core/config.py walks up from its own location to find it.
#   Frontend  vite.config.js points envDir here.
#
# Only the VITE_ keys at the bottom reach the browser. Everything above them
# stays server-side and is never bundled. Add a key here whenever you add one
# to .env, or the next person to clone gets a server that will not boot.
# =============================================================================

PROJECT_NAME=GridSphere IoT Core


# ─── Database: Neon (required) ───────────────────────────────────────────────
# Neon Console -> your project -> Connect -> copy the connection string.
# Paste it verbatim, ?sslmode=require included — app/db/url.py converts it for
# asyncpg, attaches TLS and disables prepared statements on the -pooler
# endpoint. Nothing to reshape by hand.
#
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=


# ─── Redis (optional — leave blank to disable) ───────────────────────────────
REDIS_URL=


# ─── MQTT broker ─────────────────────────────────────────────────────────────
# MQTT_BROKER must be present, but the connection is allowed to fail: the error
# is caught and logged and the server starts anyway. Set the real address only
# if you are testing fingerprint devices.
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=


# ─── JWT signing (required) ──────────────────────────────────────────────────
# Generate your own — never reuse another environment's value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ─── Task manager / GitHub integration ───────────────────────────────────────
# Blank disables GitHub sync; manual tasks still work. Once set, do not change
# it — stored GitHub tokens become unreadable and must be re-entered.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_ENC_KEY=
GITHUB_SYNC_INTERVAL_MINUTES=30
GITHUB_SYNC_PAGE_LIMIT=3


# ─── Frontend ────────────────────────────────────────────────────────────────
# Compiled into the browser bundle. Never put a secret here.
# Without this line the app falls back to the PRODUCTION API.
VITE_API_BASE_URL=http://localhost:8000
