# =========================================================
# biometric-backend — FastAPI
# Copy to .env and fill in real values. Never commit .env.
# Read by app/core/config.py (pydantic-settings, env_file=".env")
# =========================================================

PROJECT_NAME=GridSphere IoT Core

# --- Database (REQUIRED) ---
# Async driver required:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Redis (REQUIRED in this repo — app will not boot if blank) ---
# redis://HOST:6379/0
REDIS_URL=

# --- MQTT broker (MQTT_BROKER required) ---
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
